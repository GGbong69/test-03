# Godot 4+ specific ignores
.godot/
/android/

# 별개의 깃 저장소 — 이 프로젝트와 무관
테스트버전/

# 익스포트 결과물
/build/
/export/
*.exe
*.pck
*.zip

# 고닷이 CSV 에서 뽑아내는 부산물
*.translation
# 스크린샷 — scripts/tools/shot.gd 가 떨구는 검증용 결과물
/shots/*.png

# 파워포인트 잠금 파일
~$*.pptx

# 워크플로 워크트리 — 임시 체크아웃이고 저장소에 들어가면 안 된다
.claude/worktrees/
