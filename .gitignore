# Godot 4+ specific ignores
.godot/
/android/

# 별개의 깃 저장소 — 이 프로젝트와 무관
테스트버전/

# 익스포트 결과물
/build/
/export/
*.exe
*.pck
*.zip

# 고닷이 CSV 에서 뽑아내는 부산물
*.translation
# 스크린샷 — scripts/tools/shot.gd 가 떨구는 검증용 결과물
/shots/*.png

# 파워포인트 잠금 파일
~$*.pptx

# 워크플로 워크트리 — 임시 체크아웃이고 저장소에 들어가면 안 된다
.claude/worktrees/

# Meshy 산출물 — 형태만 코드로 굽고 파일은 안 들인다
/models/

# 파이썬 도구 부산물
__pycache__/

# Meshy 플러그인이 받아 오는 모델 — 게임에 들일 것만 따로 옮긴다
/imported_models/
