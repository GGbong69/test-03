	"mill_deep": 2.2,     # 물린 깊이(면 px). **안으로만 판다** — 최대 반지름 = rx
	"mill_hw":   0.13,    # 물린 자리 반폭(rad)
	"spot_w":    2.0,     # 박음 폭(화면 px). 1px 은 빗살과 안 갈린다
	"spot_skip": 0.12,    # 이 각(rad) 안의 빗살은 안 긋는다. 겹치면 둘 다 안 읽힌다
	"plq_a":     17.935,  # 플라크 반폭(면 px). 가로세로 1.40:1
	"plq_b":     12.810,  # 플라크 반높이(면 px)
	"plq_cut":   3.2,     # 모서리 넷을 깎는 길이
	"plq_side":  1.9,     # 옆면 = chip_t * tall * 이것 = 6.11px. 두꺼운 아크릴이다
	"plq_tilt":  0.175,   # ±10°. 이 위로 올리면 아래끝 잉크가 _obj_box 를 넘는다
	#  홀로 마감의 알파. 원반(0.26)보다 낮다 — 메달이 가운데만 덮어 양끝에
	#  마감이 그대로 드러나는데, 0.26 이면 어두운 몸 위에서 갈색 얼룩이 된다.
	#  **두 자세가 이 한 칸을 같이 읽는다**(2026-09-18: 누운 자세만 0.15 로
	#  고치고 선 자세에 0.26 을 남겨 두어 랙에서만 얼룩이 그대로 있었다).
	"plq_holo_a": 0.15,
	"r_mill":    16.0,    # 이 아래(화면 px)로는 실루엣을 안 문다. 골 0.8px 은 흐린 테다
	"r_spot":    12.0,    # 이 아래로는 박음을 안 찍는다. 점선으로 뭉개느니 밴드만 남긴다
	#  ── 물림의 바닥 넷 (2026-09-18) ───────────────────
	#  손으로 적은 r_mill 16.0 이 **식에서 나온 값**이 됐다:
	#    ceil(max(8.0 / (PI/6), 1.5 / 0.16)) = ceil(max(15.279, 9.375)) = 16
	#  작은 자리에서 뭉개지는 것은 **간격이 아니라 깊이**다 — 깊이가
	#  2.2·r/22.04 라 r=13 에서 1.30 · r=10 에서 1.00 이고, 물림 **개수**를
	#  줄여도 깊이는 안 살아난다. 그래서 바닥을 따로 박고 문턱을 두 식에서
	#  뽑는다(_coin_mdep). 그 결과 물림 넷 중 `axis` 하나만 10.0 으로 내려와
	#  컬렉션 13 · 런 정보 12 · 런 끝 10 까지 살고, 나머지 셋은 16.0 그대로라
	#  **오늘 그림이 한 픽셀도 안 바뀐다**(r>=16 에서 자연값 1.597 > 1.5).
	"mill_deep_min":   1.5,   # 깊이 바닥(면px). 「골 0.8px 은 흐린 테다」의 반대편 값
	"mill_deep_ratio": 0.16,  # 깊이/반지름 상한. 넘으면 물린 원반이 원반 가족을 벗어난다
	"mill_gap_min":    8.0,   # 이웃 물림 사이 둘레 거리 하한(면px)
	"coin_miter":      1.30,  # 법선 오프셋의 마이터 한계. 뾰족한 꼭짓점이 번짐을 밖으로 못 민다
}

#  ── 동전의 재질 ────────────────────────────────────────────
#  등급이 이미 몸 색과 마감을 쥔다(STK_TIERS). 재질은 그 위에 **한 겹**만
#  얹는다 — 등급을 덮지 않으므로 "한눈에 등급을 읽는다" 는 계약이 산다.
#  덮어쓰기로 갔다가는 흔함 하나가 스물다섯 가지 얼굴을 갖게 되고, 그러면
#  등급이 아니라 동전마다를 외워야 한다.
#
#  **재질은 레퍼런스가 아니라 규칙을 말한다.** 유리 대포가 유리인 것은
#  대포가 유리라서가 아니라 **판마다 부서지기** 때문이다 — 깨질 물건이라는
#  것이 손에 들기 전에 보여야 한다. 그림을 줄여 붙이면 38px 에서 뭉개지고,
#  뭉개지지 않아도 "그 영화를 아는가" 만 묻는 그림이 된다.
const MATS := {
	"c03": "glass",      # 유리 대포 — 판마다 1/6 로 부서진다(boom r2)
	"c06": "wax",        # 이카로스 — 배수 x4, 판마다 1/10 로 녹는다(boom r10)
	"l05": "wax",        # 녹는 시계 — 남은 다트가 다음 판으로 흘러간다(side carry)
	"c30": "cast",       # 윅 존 — 한 발도 안 빗나가야 한다. 무를 데가 없다
	"r09": "pixel",      # 불사의 토템 — 실패 1회 방지(k save). 규격 밖의 물건이다
	"l03": "hollow",     # NULL — 목표가 HP 가 되고 판을 부수면 끝난다. 값이 없다
}


static func _mat_of(it: Dictionary) -> String:
	return String(MATS.get(String(it.get("id", "")), ""))


