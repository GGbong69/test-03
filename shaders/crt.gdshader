shader_type canvas_item;
render_mode unshaded;

//  CRT 필터 · 화면 굴곡 — 설정 「화면」 갈래의 손잡이 둘이 이 판 하나를 민다.
//    「CRT 필터」  strength 0~1 — 주사선(빔) · 섀도 마스크 · 색 어긋남 · 형광 번짐 ·
//                                  모서리 어둠 · 흐르는 띠 · 잔상 · 깜박임
//    「화면 굴곡」 warp 0~1     — 술통 굽힘 · 둥근 검은 테(발라트로의 브라운관 곡면)
//  「약간 발라트로 같이 그 화면의 왜곡? 그런건 못 넣어?」(사용자, 2026-10-03) — 그 전까지는
//  굽힘이 CRT 손잡이에 딸린 논리 4px 짜리였다. 둘을 갈라 굴곡만 따로 세게 민다.
//  「스캔라인이랑 다른 것들도 좀 사용해 볼까?」(사용자, 2026-10-04) — 100 에서도 레트로가
//  약했다. 주사선을 빔 꼴로, 번짐을 넓게, 흐르는 띠 · 잔상을 더했다.
//
//  맨 위 CanvasLayer(game.gd 의 _crt_open)에 깔린 온 화면 ColorRect 가 이것을
//  쓴다. 게임 · HUD · 메뉴 · 말상자가 다 그려진 뒤의 화면을 한 번 따서 다시 뱉는다.
//  둘 다 0 이면 부르는 쪽이 층째 꺼 두므로 값을 한 톨도 안 낸다.
//
//  ── 화면은 **기기 픽셀**로 돈다 ─────────────────────────────
//  canvas_items 스트레치라 캔버스가 창 해상도로 그려진다 — 글자는 1280 에서
//  래스터화되고 도트는 정수배로 선다. 그래서 이 판은 기기 픽셀 하나마다 돈다.
//  **통째로 흐리지 않는다.** 뼈대 탭은 날카로운 쌍선형(sharp)이라 굽힘이 0 인
//  자리에서는 원본 텍셀을 그대로 집고, 굽은 자리에서도 이음 폭이 기기 1/4px
//  이다. 번짐은 둘레의 어두운 바탕에 **넘친 빛만 얹는** 층이라 원본 획을 안 무른다.
//
//  ── 굴곡 — 발라트로와 같은 꼴의 술통 ───────────────────────
//  화면 자리 d(논리) 의 정규 좌표 n(가운데 0 · 가장자리 ±1)에서
//      m = n + n · (n.yx)² · k        k = warp_k · warp
//  를 따 온다. 가로는 **세로 거리의 제곱**만큼, 세로는 **가로 거리의 제곱**만큼
//  바깥에서 집는다. 그래서
//    · 한가운데 · 네 변의 한가운데는 제자리다(n.yx 가 0) — HUD 가 변 가운데에서 안 잘린다
//    · 모서리일수록 바깥을 집어 원본 모서리가 안으로 끌려 들어오고, 원본 밖을 집는
//      화면 모서리는 검게 빈다 → 네 변이 바깥으로 불룩한 둥근 브라운관
//    · 원본은 둥근 모서리(rc) 말고는 **안 잘린다** — 화면 네 변의 그림(g 의 상)이
//      원본 사각을 다 두른다. 반지름 식(n·r²)은 변 가운데까지 밀어내 가장자리 HUD 를 잘랐다.
//  k 는 (0.08, 0.12) — 50 에서 (0.04, 0.06)이 모서리를 가로 12 · 세로 10 논리 px
//  안으로 들인다(발라트로 기본 CRT 의 곡면). 100 은 그 두 배.
//  ⚠ **입력이 같은 식으로 되짚는다.** 화면 d 를 누르면 그 자리에 그려진 것은 원본
//  g(d) 이므로, 게임이 읽는 포인터 자리는 전부 g(d) 를 지난다(game.gd 의 _warp_src).
//  그래서 이 식과 k · rc 를 바꾸면 그쪽도 **글자 그대로** 같이 바꾼다 — 수는 game.gd
//  의 WARP 한 곳에 살고 _crt_apply 가 여기 uniform 으로 넣는다(qa_warp 가 대 본다).
//
//  ── 테 ───────────────────────────────────────────────────
//  원본 자리가 화면(모서리 반지름 rc 의 둥근 사각) 밖이면 검다 — 굽힘이 그리는 둥근
//  변이다. 녹이는 폭 fe(논리) 의 **한가운데(0.5)가 정확히 거리 0** 이라 「누르면 화면
//  안인가」(game.gd 의 _warp_hit)와 눈에 보이는 테의 반이 같은 선이다. 테 안쪽 몇 px 는
//  유리관 두께처럼 살짝 어둡다(rim).
//
//  ── 주사선은 **화면 행**에 곧게 선다 — 굴곡을 안 따른다 ──────────
//  logical 은 지금 보이는 논리 크기다(expand 라 16:10 이면 640x400). 스크립트가
//  창이 바뀔 때마다 넣는다. 논리 1px 이 기기 몇 px 인지(ppl)를 여기서 셈해
//  화면 논리 행마다 빔 하나를 세운다(아래 「빔」).
//  굴곡을 따라 휘게 하면(원본 행 src.y 에 세우면) 2배 화면에서 행 하나가 기기 두 줄
//  뿐이라 휜 띠의 위상이 반 줄 밀리는 자리마다 띠가 두 줄에 반씩 번졌다 또렷해졌다
//  한다 — 50 의 굴곡은 위아래 변이 가로로 가면서 10px(= 기기 20줄) 처지므로 위 · 아래
//  변을 따라 물결(모아레)이 스무 개 선다. 100 이면 마흔 개다. 곧은 주사선은 화면 유리에
//  박힌 래스터로 읽히고(그림이 휘고 격자는 안 휜다) 어느 배율에서도 물결이 없다.
//  굴곡은 그림이 이미 말한다 — 둥근 테와 휜 가장자리 HUD 로 충분하다.
//
//  ── 빔 — 밝으면 굵고 어두우면 가늘다 ───────────────────────
//  예전 주사선은 행 바닥 0.4 를 납작하게 깎는 띠라 100 에서도 「살짝 어둡다」로만
//  읽혔다. 브라운관은 행마다 가우스 꼴 빔 하나가 지나고, 센 빔(밝은 화소)일수록
//  퍼져 줄 사이 검은 틈을 메운다(Lottes 의 Scan · easymode 의 빔 폭 — 생각만 따 왔다).
//  빔 한가운데는 논리 행의 위쪽 1/4 — 2배면 윗줄이 빔 한가운데, 아랫줄이 틈 한가운데라
//  기기 한 줄 밝고 한 줄 검은 결이 또렷하다. 4배면 두 줄 밝고 두 줄 어둡다.
//  틈의 밝기는 그 화소 **제 밝기**로 정한다(이웃 행의 빛을 끌어오지 않는다) —
//  틈 줄에 걸친 글자 가로획이 사라지지 않고, 밝은 글자일수록 틈이 메워져 안 끊긴다.
//  어두운 바탕은 틈이 거의 검어 결이 바탕에서 산다.
//  틈과 빔 사이는 이웃 두 빔의 가우스를 더한 값이다 — 행 경계 위아래가 대칭이라
//  배율이 몇이든 기기 행에 딱 맞아 물결이 없다.
//
//  ── 형광 번짐 — 밝은 덩어리만 넓게 ─────────────────────────
//  화면 읽기의 밉맵(엔진이 가우스로 줄여 둔 사다리)에서 두 단(논리 수 px 퍼진 그림)을
//  집는다 — 탭 둘로 넓은 번짐을 얻는다(예전 여덟 탭 고리는 논리 2px 이 끝이었다).
//  퍼진 빛이 그 자리보다 밝은 만큼만 얹고, 그 몫은 퍼진 빛의 밝기에 무릎을 걸어
//  **넓고 밝은 덩어리**(다트판 흰 칸 · 큰 단추 · 큰 제목) 둘레만 번진다. 작은 글자는
//  퍼지면 바탕과 섞여 어두워 획 둘레에 달무리가 안 선다. 밝은 곳은 그대로다 — 덮어
//  얹으면(screen) 주황 단추가 바래고 다트판 빨강이 분홍이 됐다. 셋째 탭(논리 1px
//  퍼짐)이 밝은 단추 위 검은 글자를 지킨다(⑤).
//
//  ── 흐르는 띠 · 잔상 · 깜박임 — 시간에 따라 움직이는 것 ─────────
//  motion 이 0(모션 끄기)이면 셋 다 없다.
//    흐르는 띠 — 밝은 가로 띠 하나가 위에서 아래로 roll_t 초에 한 번 지나간다. 아주 옅다.
//    잔상 — 앞 틀(prev)이 있으면 지금 화소와 앞 틀 × 남는 몫 중 밝은 쪽을 낸다. 밝은 것이
//      지나간 자리가 몇 틀 남는다. 주사선 · 마스크 · 테는 화소마다 제자리라 앞 틀과
//      지금이 같은 결을 쓴다 — 가만있는 그림은 앞 틀 × 몫이 늘 작아 안 바뀐다.
//      prev 는 넣는 쪽(scripts/crt_trail.gd)이 한 틀 끝에 다 그린 화면을 복사해 둔 것이다.
//      안 넣으면 기본 검정이라 잔상이 없다.

uniform sampler2D scene : hint_screen_texture, filter_linear, repeat_disable;
//  같은 화면의 밉맵 — 번짐만 읽는다. 엔진이 층을 그리기 전에 가우스로 줄여 둔다.
uniform sampler2D scene_mip : hint_screen_texture, filter_linear_mipmap, repeat_disable;
//  앞 틀(다 그린 화면). 넣는 쪽이 없으면 검정 — 잔상이 없다.
uniform sampler2D prev : hint_default_black, filter_nearest, repeat_disable;
uniform float strength : hint_range(0.0, 1.0) = 0.4;
//  화면 고르기(game.gd FSEL · 2026-10-10) — 화면 UV x 가 split 보다 오른쪽이면 원본을 그대로 낸다.
//  고르기 밖에서는 2(가름 없음).
uniform float split = 2.0;
uniform vec2 logical = vec2(640.0, 360.0);
//  흐르는 띠 · 잔상 · 깜박임 · 낟알을 켤 것인가. 모션 끄기면 0.
uniform float motion : hint_range(0.0, 1.0) = 1.0;

//  화면 굴곡 0~1. 0 이면 굽힘 · 테가 없고 따는 자리가 정확히 제자리다.
uniform float warp : hint_range(0.0, 1.0) = 0.0;
//  다 켰을 때(warp 1)의 값. warp 가 곱해진다. 넣는 쪽은 game.gd 의 WARP 다.
uniform vec2 warp_k = vec2(0.08, 0.12);    // 술통 세기(가로 · 세로)
uniform float warp_rc = 16.0;              // 테의 둥근 모서리 반지름(원본 논리 px)
uniform float warp_fe = 2.0;               // 테를 녹이는 폭(논리 px)
uniform float warp_rim = 0.30;             // 테 안쪽 그늘의 짙기

//  다 켰을 때(strength 1)의 값. strength 가 전부에 곱해진다.
uniform float scan : hint_range(0.0, 1.0) = 1.0;      // 주사선 — 빔 결의 깊이
uniform float beam_lo : hint_range(0.05, 0.5) = 0.15; // 어두운 화소의 빔 반폭(논리 행 단위)
uniform float beam_hi : hint_range(0.05, 0.5) = 0.31; // 밝은 화소의 빔 반폭
uniform float gain : hint_range(0.0, 1.0) = 0.55;     // 빔이 먹은 밝기를 되돌린다(어두울수록 다)
uniform float mask : hint_range(0.0, 1.0) = 0.16;     // 섀도 마스크(기기 열마다 색)
uniform float aberr = 0.45;                           // 모서리 색 어긋남(논리 px)
uniform float glow : hint_range(0.0, 2.0) = 0.40;     // 형광 번짐 세기
uniform float glow_cut : hint_range(0.0, 1.0) = 0.30; // 번짐 문턱 — 퍼진 밝기가 이 위인 둘레만
uniform float vig : hint_range(0.0, 1.0) = 0.30;      // 모서리 어둠
uniform float roll = 0.05;                            // 흐르는 띠의 밝기
uniform float roll_t = 7.0;                           // 띠가 한 번 지나가는 데 걸리는 초
uniform float trail : hint_range(0.0, 0.95) = 0.55;   // 잔상 — 한 틀(1/60 초)에 남는 몫
uniform float trail_dt = 1.0;                         // 앞 틀과의 사이(1/60 초 단위)
uniform float flick : hint_range(0.0, 0.1) = 0.012;   // 깜박임 · 낟알

//  날카로운 쌍선형. p 는 기기 픽셀 좌표(가운데가 .5). 텍셀 사이 이음을
//  1/4px 로 좁혀 최근접의 또렷함과 쌍선형의 고른 폭을 같이 얻는다.
//  p 가 정확히 텍셀 가운데면 f 가 0 이 되어 원본을 그대로 집는다.
vec3 sharp(vec2 p, vec2 sps) {
	vec2 q = p - 0.5;
	vec2 i = floor(q);
	vec2 f = clamp((fract(q) - 0.5) * 4.0 + 0.5, 0.0, 1.0);
	return texture(scene, (i + 0.5 + f) * sps).rgb;
}

//  g(d) — 화면 자리 d(논리 px) 에 따 오는 원본 자리. game.gd 의 _warp_src 와 같은 식.
vec2 warp_src(vec2 d, vec2 L, float w) {
	vec2 n = d / L * 2.0 - 1.0;
	vec2 m = n + n * (n.yx * n.yx) * (warp_k * w);
	return (m + 1.0) * 0.5 * L;
}

//  원본 자리 s 가 둥근 화면(L · 모서리 rc) 밖으로 얼마나 나갔나(논리 px). 음수면 안.
//  game.gd 의 _warp_out 과 같은 식.
float warp_out(vec2 s, vec2 L, float rc) {
	vec2 h = L * 0.5;
	vec2 q = abs(s - h) - (h - vec2(rc));
	return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - rc;
}

float luma(vec3 c) {
	return dot(c, vec3(0.299, 0.587, 0.114));
}

void fragment() {
	if (SCREEN_UV.x > split) {
		COLOR = vec4(texture(scene, SCREEN_UV).rgb, 1.0);
	} else {
	vec2 sps = SCREEN_PIXEL_SIZE;
	float s = strength;
	//  논리 1px 당 기기 px. 정수배 스트레치라 2 · 3 · 4 … 로 떨어진다.
	float ppl = (1.0 / sps.y) / logical.y;
	vec2 uv = SCREEN_UV;
	vec2 n = uv * 2.0 - 1.0;             // 한가운데 0 · 가장자리 ±1
	float r2 = dot(n, n) * 0.5;          // 한가운데 0 · 변 가운데 0.5 · 모서리 1

	//  ① 굽힘 — 0 이면 식을 안 지나 제자리를 그대로 집는다(기기 픽셀 가운데 그대로).
	vec2 src = uv * logical;                        // 논리 좌표
	if (warp > 0.0) {
		src = warp_src(src, logical, warp);
	}
	vec2 sp = src * ppl;                            // 기기 좌표

	//  ② 뼈대 + 색 어긋남. 한가운데는 0 이라 글자 획이 안 갈린다.
	//  어긋남은 **차이로만** 얹는다(쌍선형 탭 셋: 제자리 · ±ca). 빨강 · 파랑을
	//  날카로운 탭으로 따로 따면 기기 1px 미만의 어긋남이 반올림돼 어떤 띠에서는
	//  0 · 어떤 띠에서는 꼭 1px 로 튀었다 — 40 에서도 모서리 HUD 의 「24」가
	//  초록 · 빨강 테를 둘렀다. 차이로 얹으면 어긋남이 0.3px 면 0.3px 만큼만 번진다.
	vec2 ca = n * r2 * aberr * s * ppl;
	vec3 c = sharp(sp, sps);
	vec3 l0 = texture(scene, sp * sps).rgb;
	c.r += texture(scene, (sp + ca) * sps).r - l0.r;
	c.b += texture(scene, (sp - ca) * sps).b - l0.b;
	c = clamp(c, 0.0, 1.0);
	vec3 c0 = c;                                    // 빔 · 마스크 앞의 제 색(번짐이 견준다)

	//  ③ 빔 — 화면 논리 행마다 하나. a 는 이 행 빔 한가운데(행 위쪽 1/4)까지의
	//  거리(논리 행 단위, 0~0.75), 1 − a 는 반대편 이웃 빔까지. 둘의 가우스를 더한다.
	//  빔 반폭은 그 화소 제 밝기(가장 센 채널과 휘도의 가운데 — easymode 의 잣대)로 —
	//  밝은 글자는 굵은 빔이라 틈이 메워진다. 밝기 0.6 에서 이미 다 굵다(smoothstep) —
	//  HUD 의 흐린 글(「이자 +4」 · 밝기 0.45)도 틈이 메워져 안 끊기고, 바탕(0.15 쯤)은
	//  가는 빔이라 틈이 검다. 깊이는 세기의 0.75 제곱 — 40 이면 절반 깊이라 결이 읽힌다.
	//  틈이 먹은 밝기는 빔 줄을 키워 되돌린다(gain). 어두운 화소일수록 다 되돌린다 —
	//  밝은 화소는 빔 줄이 1 에 닿아 키워 봐야 색만 바래고, 어두운 바탕은 틈이 거의
	//  검어 안 키우면 화면이 통째로 가라앉는다.
	//  굴곡을 안 따른다(머리말 「주사선은 화면 행에 곧게 선다」).
	float k = scan * pow(s, 0.75);
	if (k > 0.0) {
		float a = abs(fract(FRAGCOORD.y / ppl) - 0.25);
		float br = (max(c.r, max(c.g, c.b)) + luma(c)) * 0.5;
		float sg = mix(beam_lo, beam_hi, smoothstep(0.0, 0.6, br));
		float iw = 0.5 / (sg * sg);
		float b = 1.0 - a;
		float bw = exp(-a * a * iw) + exp(-b * b * iw);
		c *= mix(1.0, bw * (1.0 + gain * (1.0 - 0.5 * br)), k);
	}

	//  ④ 마스크 — 2배 이하면 자홍 · 초록 두 줄, 그 위면 빨 · 초 · 파 세 줄.
	//  어느 쪽이든 한 벌이 논리 1px 에 든다. 셋을 고르게 밀고 당겨 회색이 안 물든다 —
	//  한 벌의 평균이 채널마다 꼭 1 이라 마스크가 밝기를 안 먹는다(예전엔 깎기만 해
	//  100 에서 흰 칸이 8% 가라앉았다).
	float m = mask * s;
	float col = floor(FRAGCOORD.x);
	vec3 mk;
	if (ppl < 2.5) {
		float h2 = m * 0.5;
		mk = mod(col, 2.0) < 1.0 ? vec3(1.0 + h2, 1.0 - h2, 1.0 + h2)
				: vec3(1.0 - h2, 1.0 + h2, 1.0 - h2);
	} else {
		float k3 = mod(col, 3.0);
		vec3 e = k3 < 1.0 ? vec3(1.0, 0.0, 0.0)
				: (k3 < 2.0 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0));
		mk = vec3(1.0 - m / 3.0) + e * m;
	}
	c *= mk;
	//  1 을 넘은 채널을 따로 자르면 색이 돈다(빔 줄을 키운 주황 단추가 레몬색이 됐다) —
	//  가장 센 채널로 나눠 색상을 지킨다.
	c /= max(1.0, max(c.r, max(c.g, c.b)));

	//  ⑤ 형광 번짐 — 밉맵 두 단(논리 수 px 퍼진 그림 — H). 단은 배율을 따라 올린다(4배면
	//  한 단 위) — 번지는 폭이 논리 px 로 같다.
	//  **넘친 만큼만** 얹는다: 퍼진 빛 H 가 이 자리보다 밝은 곳 — 밝은 덩어리 둘레의
	//  어두운 바탕 — 에만 빛이 번져 나간다. 덩어리 안은 H 가 제 색과 같아 안 바뀐다
	//  (단추 · 흰 칸이 바래지 않고 주사선도 그대로 선다).
	//  「이 자리」는 제 색과 논리 1px 쯤 퍼진 이웃(hl) 중 밝은 쪽이다 — 밝은 단추 위의
	//  검은 글자 획은 이웃이 이미 밝아 번짐이 안 스며든다(「다음 판」이 회색으로 안 뜬다).
	//  얹는 몫은 H 의 밝기로 무릎을 건다(glow_cut ± 0.2) — 작은 글자 · 어둑한 나뭇결 둘레는
	//  H 가 낮아 안 번지고, 큰 단추 · 흰 칸 둘레만 번진다. 문턱을 H 의 몫에 걸지 H 자체를
	//  깎지 않는다 — 깎으면 덩어리 바로 바깥(H 가 반쯤)부터 문턱 밑이라 둘레로 못 나갔다.
	float gk = glow * s;
	if (gk > 0.0) {
		float lb = log2(max(ppl, 1.0));
		vec2 su = src / logical;
		vec3 h = textureLod(scene_mip, su, lb + 2.5).rgb * 0.6
				+ textureLod(scene_mip, su, lb + 3.5).rgb * 0.4;
		vec3 hl = textureLod(scene_mip, su, lb + 1.0).rgb;
		float w = smoothstep(glow_cut - 0.2, glow_cut + 0.2, luma(h));
		c += max(h - max(c0, hl), vec3(0.0)) * (gk * w);
	}

	//  ⑥ 모서리 어둠
	c *= 1.0 - vig * s * smoothstep(0.2, 1.0, r2);

	//  ⑦ 흐르는 띠 · 깜박임 · 낟알 — 아주 옅게. 모션 끄기면 없다.
	//  띠는 화면 위 밖(−0.25)에서 아래 밖(1.25)으로 — 화면에 없는 틈이 있어 늘 흐르는
	//  것으로 안 읽히고 이따금 지나가는 것으로 읽힌다. 곱하기만 하면 검은 바탕에서
	//  안 보여 바닥을 조금 들어 준다(밝기의 1/4 만큼).
	if (motion > 0.5) {
		float yb = fract(TIME / max(roll_t, 0.5)) * 1.5 - 0.25;
		float dy = (uv.y - yb) / 0.06;
		float rb = roll * s * exp(-dy * dy);
		c = c * (1.0 + rb) + rb * 0.25;
		float nz = fract(sin(dot(floor(FRAGCOORD.xy / ppl) + floor(TIME * 30.0),
				vec2(12.9898, 78.233))) * 43758.5453) - 0.5;
		c = c * (1.0 + flick * s * sin(TIME * 37.7)) + nz * flick * s;
	}

	//  ⑧ 테 — 원본 자리가 둥근 화면 밖이면 검다. 녹이는 폭의 한가운데가 거리 0 이다.
	//  굴곡이 0 이면 반지름 0 · 폭 기기 1px — 가장자리 기기 픽셀(거리 −½ 기기 px)이
	//  꼭 1 로 남아 CRT 만 켠 화면은 테가 없다.
	float dist = warp_out(src, logical, warp_rc * warp);
	float fe = max(warp_fe * warp, 1.0 / ppl);
	float inb = clamp(0.5 - dist / fe, 0.0, 1.0);
	//  테 안쪽 그늘 — 거리 0 에서 rim 만큼 어둡고 안으로 10px 에 걸쳐 걷힌다.
	float rim = 1.0 - warp_rim * warp * (1.0 - smoothstep(0.0, 10.0, -dist));
	vec3 o = clamp(c, 0.0, 1.0) * inb * rim;

	//  ⑨ 잔상 — 앞 틀(다 그린 화면) × 남는 몫과 견줘 밝은 쪽. 몫은 틀 사이 시간만큼
	//  거듭제곱해 화면 빈도가 달라도 같은 시간 동안 남는다. 세기의 √ 를 곱해 40 에서도
	//  한두 틀은 남는다.
	if (motion > 0.5) {
		float tk = pow(trail * sqrt(s), clamp(trail_dt, 0.25, 4.0));
		o = max(o, texture(prev, uv).rgb * tk);
	}
	COLOR = vec4(o, 1.0);
	}
}
