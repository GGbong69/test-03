#undef T
//  ── 팔레트 끝 ──

void fragment() {
	if (SCREEN_UV.x > split) {
		COLOR = vec4(texture(scene, SCREEN_UV).rgb, 1.0);
	} else {
	vec3 c = texture(scene, SCREEN_UV).rgb;
	float s = strength;
	vec3 o = c;
	if (s > 0.0) {
		vec2 sps = SCREEN_PIXEL_SIZE;
		//  ① 가장자리 — 이웃 넷(기기 1px)과의 휘도 대비. 넘으면 원본 그대로.
		float y0 = luma(c);
		float lo = y0;
		float hi = y0;
		float yk = luma(texture(scene, SCREEN_UV + vec2(sps.x, 0.0)).rgb);
		lo = min(lo, yk);
		hi = max(hi, yk);
		yk = luma(texture(scene, SCREEN_UV - vec2(sps.x, 0.0)).rgb);
		lo = min(lo, yk);
		hi = max(hi, yk);
		yk = luma(texture(scene, SCREEN_UV + vec2(0.0, sps.y)).rgb);
		lo = min(lo, yk);
		hi = max(hi, yk);
		yk = luma(texture(scene, SCREEN_UV - vec2(0.0, sps.y)).rgb);
		lo = min(lo, yk);
		hi = max(hi, yk);
		if (hi - lo <= edge_cut) {
			//  ② 가장 가까운 색 P1 — 세기만큼 줄인 팔레트(앞 K 색)에서, 화소 명도 근처 띠만.
			int K = int(floor(mix(float(PAL_N), float(PAL_KEEP), s) + 0.5));
			vec3 x = to_lab(c);
			float d1 = 1e9;
			vec3 l1 = vec3(0.0);
			vec3 c1 = c;
			float e2 = 1e9;
			vec3 c2 = c;
			pal_scan(0, x, K, d1, l1, c1, e2, c2);
			vec3 q = c1;
			//  ③ 짝 P2 — 오차 + 먼 짝 벌이 P1 하나보다 작은 것 중 가장 작은 것.
			//  팔레트 색 그대로면(OKLab 거리 0.004 안) 짝을 안 찾는다 — 글 · 판 · 단추가 그렇다.
			if (d1 >= 0.000016) {
				e2 = d1;
				c2 = c1;
				pal_scan(1, x, K, d1, l1, c1, e2, c2);
				if (e2 < d1) {
					//  ④ 섞는 몫은 선형 빛에서 — 그다음 snap 을 걷어 낸다.
					vec3 a = to_lin(c1);
					vec3 dl = to_lin(c2) - a;
					float t = clamp(dot(to_lin(c) - a, dl) / max(dot(dl, dl), 1e-8), 0.0, 1.0);
					float sn = mix(snap_lo, snap_hi, s);
					t = clamp((t - sn) / max(1.0 - 2.0 * sn, 0.001), 0.0, 1.0);
					//  ⑤ 논리 칸의 문턱 — 몫이 문턱을 넘으면 짝을 놓는다.
					float ppl = (1.0 / sps.y) / logical.y;
					float th = bayer4(ivec2(floor(FRAGCOORD.xy / ppl)));
					if (th < t) {
						q = c2;
					}
				}
			}
			o = mix(c, q, smoothstep(0.0, fade_in, s));
		}
	}
	COLOR = vec4(o, 1.0);
	}
}
