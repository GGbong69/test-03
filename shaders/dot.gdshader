shader_type canvas_item;
render_mode unshaded;

//  도트 팔레트 — 색 수를 줄이고 격자무늬(순서) 디더로 계조를 낸다. 16비트 게임기 화면처럼.
//    strength 0~1 한 게이지 — 0 은 원본 그대로, 올릴수록 팔레트가 줄고 디더가 짙다.
//  CanvasLayer 97(장면 덮개 95 위 · CRT 100 밑)의 온 화면 ColorRect 가 쓴다. 깨끗한 그림을
//  먼저 줄이고 CRT 가 그 위에 주사선 · 번짐을 얹는다 — 거꾸로 서면 주사선 띠까지 팔레트로
//  눌려 디더가 가로 줄무늬를 탄다.
//  0 이면 부르는 쪽이 층째 끈다(CRT 와 같은 규약). 시간을 안 쓴다 — 움직이는 것이 없다.
//
//  ── 두 길 중 팔레트 ───────────────────────────────────────
//  ① 채널마다 단계 줄이기(메가드라이브 9비트 = 채널 8단 · 슈퍼패미컴 15비트 = 32단)
//  ② 다듬은 팔레트에서 가장 가까운 두 색을 디더로 섞기
//  둘을 제목 · 판 · 상점에 대 봤다(2026-10-04, shots/retro_dot_cmp_*). ①은 격자 위에 안
//  앉은 색이면 **다 디더가 된다** — 판(221d33) · 바탕(14111f)도 격자 사이라 HUD 판이 온통
//  지글거리고, 100(채널 4단)에서 「이자 +4」(C_DIM)가 푸른 바탕 낟알에 먹혔다. 어두운 데
//  단계가 0 · 85 둘뿐이라 나무 바닥은 보라 · 분홍 바둑판이 됐다. ②는 게임 상수가 팔레트에
//  **그대로** 있어 글 · 판 · 단추가 한 톨도 안 바뀌고, 계조(3D 손 · 벨벳 · 나무 그늘 ·
//  가림막 밑 판)만 디더로 넘어간다.
//  뼈대는 coin_paint.PAL(동전 · 와펜 그림의 램프 열넷 × 네 단 — 그늘은 보라, 빛은 백색 쪽으로
//  민다)이고 방의 재질(벨벳 · 나무 · 벽)을 보탰다 — 3D 방과 손이 2D 그림과 같은 물감으로 선다.
//  색표는 scripts/tools/dot_pal.py 가 쓴다(OKLab 을 미리 셈해 박으므로 손으로 고치지 않는다).
//
//  ── 디더 격자는 **논리 픽셀**에 선다 ───────────────────────
//  Bayer 4x4 의 한 칸이 논리 1px(= 기기 ppl px)이다. 기기 픽셀에 세우면 2배 창과 4배 창의
//  무늬 굵기가 갈리고 4배에서는 너무 고와 무늬가 아니라 회색으로 읽힌다. 색은 기기 픽셀마다
//  고른다 — 글자는 창 해상도로 래스터화되므로 논리 칸째 뭉개면 9px 한글이 무너진다.
//  4x4 인 것: 2x2(바둑판)는 네 단뿐이라 손등 그늘이 25 · 50 · 75% 띠로 끊겼고, 8x8 은 논리
//  8px 마다 되풀이라 손가락(3~4px)처럼 작은 데서 무늬가 못 서고 낟알로 읽혔다.
//
//  ── 두 색 고르기 ──────────────────────────────────────────
//  OKLab 에서 가장 가까운 색 P1 을 고르고, P1 과 섞어 그 색에 가장 가까이 가는 짝 P2 를
//  찾는다 — 오차 + pair_pen · t(1−t) · |P2−P1|² 가 가장 작은 짝. 벌이 없으면 회색을
//  흑 · 백 바둑판으로 내는 식의 먼 짝이 이겨 낟알이 굵고 색이 튄다.
//  섞는 몫 t 는 **선형 빛**에서 다시 잰다 — 디더는 눈에서 선형으로 섞이므로 OKLab 몫을 그대로
//  쓰면 반반 자리가 밝게 뜬다. t 가 snap 안쪽이면 점을 안 놓는다 — 단추에 얹힌 10% 밝힘 ·
//  가림막 밑 바탕처럼 팔레트에서 한 끗 벗어난 넓은 면이 성긴 점으로 지글거리지 않게.
//
//  ── 글자 가장자리는 원본 ───────────────────────────────────
//  휘도 대비가 edge_cut 을 넘는 자리(기기 1px 이웃 넷)는 원본 화소를 그대로 낸다. 페이퍼로지는
//  창 해상도에서 안티에일리어싱되는데, 반쯤 섞인 그 화소를 팔레트에 대면 짝이 흔히 보라 · 주황이
//  되어 획 테두리에 색 점이 돋았다. 대 본 셋 — 디더 그대로 · 가까운 한 색 · 원본 — 중 가까운 한
//  색도 「구매」 획 안쪽에 보라 점이 남았고, 원본만 깨끗했다. 글 · 판 색은 팔레트에 있으므로 획
//  몸은 어차피 그대로다 — 원본을 내는 것은 테두리 기기 1px 띠뿐이다.
//
//  ── 세기 ─────────────────────────────────────────────────
//  팔레트 PAL_N → PAL_KEEP 색(단 2 가 끝에서부터 빠진다) · snap snap_lo → snap_hi.
//  fade_in 아래에서는 원본과 섞어 켠다 — 0.01 에서 온 화면이 한꺼번에 바뀌지 않게.
//
//  ── 값 ───────────────────────────────────────────────────
//  화소 하나에 팔레트를 두 번 돈다(P1 · P2). 표는 명도 띠로 묶여 화소 명도 근처 띠만 대 보고
//  (백 색 중 스물에서 쉰), 팔레트 색 그대로인 화소(UI 의 거의 다)는 짝 찾기를 건너뛰고,
//  가장자리 화소는 둘 다 건너뛴다. 상점 · 세기 1 에서 GTX 1660 Ti 로 잰 값(shot_retro_dot 의
//  「값」 줄, 판마다 들쭉날쭉): 1280x720 +0.8~1.3ms · 2560x1440 +1.9~3.7ms. 표를 배열로 두고
//  차례로 집던 첫 판은 +3.2 · +7.1ms 였다. 여든아홉 → 백셋 색(띠 · 덮개 · 번짐)으로 늘린 뒤
//  한 판: +0.9 · +3.6ms.

uniform sampler2D scene : hint_screen_texture, filter_nearest, repeat_disable;
//  설정 게이지가 민다. 기본 0.6 — 단 2 가 반쯤 빠져 그늘 · 3D 손에 무늬가 또렷이 선다.
uniform float strength : hint_range(0.0, 1.0) = 0.6;
//  화면 고르기(game.gd FSEL · 2026-10-10) — 화면 UV x 가 split 보다 오른쪽이면 원본을 그대로 낸다.
//  고르기 밖에서는 2(가름 없음).
uniform float split = 2.0;
//  지금 보이는 논리 크기(expand 라 16:10 이면 640x400). 부르는 쪽이 창이 바뀔 때마다 넣는다.
uniform vec2 logical = vec2(640.0, 360.0);

uniform float pair_pen : hint_range(0.0, 2.0) = 0.4;   // 먼 짝을 섞는 벌
uniform float snap_lo : hint_range(0.0, 0.5) = 0.25;   // 세기 0 쪽의 snap — 이 안쪽 몫은 점을 안 놓는다
uniform float snap_hi : hint_range(0.0, 0.5) = 0.05;   // 세기 1 의 snap
uniform float fade_in : hint_range(0.0, 1.0) = 0.15;   // 이 세기까지 원본과 섞어 켠다
//  2026-10-10 1.01(끔) — 「폰트에는 필터나 라이팅이 안되어 잇는거 같아서 좀 어색하다는 평」. 옛 0.2 는
//  글자 획 테두리를 원본으로 남겨 글자만 팔레트 · 디더를 안 탔다. 이제 글자도 그림과 같이 탄다.
uniform float edge_cut : hint_range(0.0, 1.01) = 1.01; // 이 휘도 대비를 넘으면 원본을 낸다

vec3 to_lin(vec3 c) {
	return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

vec3 to_lab(vec3 c) {
	vec3 l = to_lin(c);
	vec3 lms = vec3(dot(l, vec3(0.4122214708, 0.5363325363, 0.0514459929)),
			dot(l, vec3(0.2119034982, 0.6806995451, 0.1073969566)),
			dot(l, vec3(0.0883024619, 0.2817188376, 0.6299787005)));
	lms = pow(max(lms, vec3(0.0)), vec3(1.0 / 3.0));
	return vec3(dot(lms, vec3(0.2104542553, 0.7936177850, -0.0040720468)),
			dot(lms, vec3(1.9779984951, -2.4285922050, 0.4505937099)),
			dot(lms, vec3(0.0259040371, 0.7827717662, -0.8086757660)));
}

//  Bayer 4x4 문턱(0~1, 칸 가운데). p 는 논리 칸 좌표.
float bayer4(ivec2 p) {
	int x = p.x & 3;
	int y = p.y & 3;
	int xy = x ^ y;
	int v = ((xy & 1) << 3) | ((y & 1) << 2) | (xy & 2) | ((y & 2) >> 1);
	return (float(v) + 0.5) / 16.0;
}

float luma(vec3 c) {
	return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

//  팔레트 색 하나(표 차례 i · OKLab lab · sRGB rgb)를 대 본다. pal_scan 이 두 번 부른다.
//    pass 0  가장 가까운 색 P1(d1 거리 · l1 OKLab · c1 sRGB)
//    pass 1  P1 과 섞어 x 에 가장 가까이 가는 짝 P2(e2 오차 + 먼 짝 벌 · c2 sRGB)
//  팔레트를 배열로 두고 차례로 집으면 GPU 가 화소마다 표 전체를 지역 메모리에 옮겨 놓고
//  읽는다 — 그래서 표는 이 함수를 부르는 줄로 풀어 쓰고(pal_scan) 값은 레지스터에 든다.
//  「가까운 넷」을 한 번에 모으는 쪽은 끼워 넣기 갈래가 셀렉트로 펴져 두 번 도는 이것보다 느렸다.
void take(int pass, int i, int K, vec3 x, vec3 lab, vec3 rgb,
		inout float d1, inout vec3 l1, inout vec3 c1, inout float e2, inout vec3 c2) {
	if (i >= K) {
		return;
	}
	if (pass == 0) {
		vec3 dv = x - lab;
		float d = dot(dv, dv);
		if (d < d1) {
			d1 = d;
			l1 = lab;
			c1 = rgb;
		}
	} else {
		vec3 dv = lab - l1;
		float dd = dot(dv, dv);
		if (dd > 1e-8) {
			float t = clamp(dot(x - l1, dv) / dd, 0.0, 1.0);
			vec3 r = x - (l1 + dv * t);
			float e = dot(r, r) + pair_pen * t * (1.0 - t) * dd;
			if (e < e2) {
				e2 = e;
				c2 = rgb;
			}
		}
	}
}

//  ── 팔레트 — scripts/tools/dot_pal.py 가 쓴다. 손으로 고치지 않는다 ──
//  단 0 · 1 이 앞 66 색 — 세기 1 에서도 남는다. 단 2 는 뒤에서부터 빠진다.
const int PAL_N = 103;
const int PAL_KEEP = 66;
//  줄마다 한 색 — T(표 차례, OKLab, sRGB). OKLab 은 sRGB 를 옮긴 값이다.
#define T(i, lab, rgb) take(pass, i, K, x, lab, rgb, d1, l1, c1, e2, c2)
void pal_scan(int pass, vec3 x, int K,
		inout float d1, inout vec3 l1, inout vec3 c1, inout float e2, inout vec3 c2) {
	if (x.x > -1.00 && x.x < 0.30) {    // L 0.1~0.2
		T(0, vec3(0.1887, 0.0112, -0.0260), vec3(0.0784, 0.0667, 0.1216));  // 14111f 바탕 C_BG · 단 0
		T(1, vec3(0.1582, 0.0086, -0.0215), vec3(0.0510, 0.0431, 0.0863));  // 0d0b16 제목 바탕(판 가림막 밑) · 단 0
		T(31, vec3(0.1473, 0.0080, -0.0178), vec3(0.0431, 0.0353, 0.0706));  // 0b0912 밤 0 · 단 1
		T(37, vec3(0.1735, 0.0368, 0.0173), vec3(0.1216, 0.0314, 0.0275));  // 1f0807 벨벳 0 · 단 1
		T(43, vec3(0.1542, 0.0148, 0.0184), vec3(0.0784, 0.0353, 0.0157));  // 140904 나무 0 · 단 1
		T(99, vec3(0.1816, 0.0208, -0.0120), vec3(0.0941, 0.0549, 0.0902));  // 180e17 벽 0 · 단 2
	}
	if (x.x > 0.10 && x.x < 0.40) {    // L 0.2~0.3
		T(2, vec3(0.2476, 0.0166, -0.0380), vec3(0.1333, 0.1137, 0.2000));  // 221d33 판 C_PANEL · 단 0
		T(3, vec3(0.2418, 0.0124, -0.0239), vec3(0.1294, 0.1137, 0.1686));  // 211d2b 다트판 테 · 단 0
		T(4, vec3(0.2774, 0.0187, -0.0323), vec3(0.1686, 0.1412, 0.2196));  // 2b2438 짙은 C_DARK · 단 0
		T(5, vec3(0.2994, 0.0149, -0.0367), vec3(0.1804, 0.1647, 0.2510));  // 2e2a40 꺼진 단추 · 단 0
		T(7, vec3(0.2068, 0.0165, -0.0276), vec3(0.1020, 0.0784, 0.1412));  // 1a1424 잉크(coin_paint.INK) · 단 0
		T(24, vec3(0.2795, 0.0179, -0.0210), vec3(0.1765, 0.1451, 0.2000));  // 2d2533 고른 줄 띠 1(C_ACC 5.5%) · 단 0
		T(28, vec3(0.2745, 0.0283, -0.0554), vec3(0.1686, 0.1255, 0.2588));  // 2b2042 덮개 WIPE.col 0 · 단 0
		T(33, vec3(0.2153, 0.0134, 0.0004), vec3(0.1216, 0.0902, 0.0980));  // 1f1719 잿빛 0(조끼 · 벽 그늘) · 단 1
		T(38, vec3(0.2295, 0.0516, 0.0250), vec3(0.2000, 0.0627, 0.0549));  // 33100e 벨벳 1 · 단 1
		T(39, vec3(0.2812, 0.0742, 0.0362), vec3(0.2902, 0.0784, 0.0706));  // 4a1412 벨벳 2 · 단 1
		T(42, vec3(0.2638, 0.0564, -0.0025), vec3(0.2275, 0.0941, 0.1451));  // 3a1825 벽(보라 밤색) · 단 1
		T(44, vec3(0.2255, 0.0287, 0.0330), vec3(0.1725, 0.0824, 0.0314));  // 2c1508 나무 1 · 단 1
		T(53, vec3(0.2981, -0.0340, 0.0142), vec3(0.1137, 0.2000, 0.1490));  // 1d3326 초록 0 · 단 1
		T(70, vec3(0.2737, 0.0067, -0.0017), vec3(0.1647, 0.1490, 0.1569));  // 2a2628 잿빛 0b · 단 2
		T(75, vec3(0.2716, 0.0044, -0.0858), vec3(0.1020, 0.1294, 0.3137));  // 1a2150 파랑 0 · 단 2
		T(77, vec3(0.2781, 0.0339, -0.0812), vec3(0.1686, 0.1137, 0.3098));  // 2b1d4f 보라 0 · 단 2
		T(85, vec3(0.2866, 0.0833, 0.0051), vec3(0.2902, 0.0784, 0.1490));  // 4a1426 빨강 0 · 단 2
	}
	if (x.x > 0.20 && x.x < 0.50) {    // L 0.3~0.4
		T(6, vec3(0.3450, 0.0200, -0.0481), vec3(0.2275, 0.2039, 0.3216));  // 3a3452 HUD 단추 · 단 0
		T(25, vec3(0.3128, 0.0196, -0.0046), vec3(0.2235, 0.1765, 0.2000));  // 392d33 고른 줄 띠 2(C_ACC 11%) · 단 0
		T(26, vec3(0.3448, 0.0195, 0.0100), vec3(0.2667, 0.2078, 0.2000));  // 443533 고른 줄 띠 3(C_ACC 16.5%) · 단 0
		T(27, vec3(0.3800, 0.0188, 0.0248), vec3(0.3137, 0.2431, 0.2000));  // 503e33 고른 줄 띠 4(C_ACC 22% · SETB.a) · 단 0
		T(29, vec3(0.3318, 0.0923, 0.0174), vec3(0.3608, 0.1098, 0.1647));  // 5c1c2a 덮개 WIPE.col 1 · 단 0
		T(34, vec3(0.3455, 0.0063, -0.0016), vec3(0.2353, 0.2196, 0.2275));  // 3c383a 잿빛 1(그늘 진 백색 칸) · 단 1
		T(40, vec3(0.3119, 0.0814, 0.0407), vec3(0.3373, 0.0980, 0.0863));  // 561916 벨벳 3(상점 테이블 빛) · 단 1
		T(45, vec3(0.3168, 0.0153, 0.0386), vec3(0.2510, 0.1804, 0.1020));  // 402e1a 나무 결 · 단 1
		T(46, vec3(0.3699, 0.0461, 0.0580), vec3(0.3686, 0.2000, 0.0902));  // 5e3317 나무 2 · 단 1
		T(67, vec3(0.3817, 0.0315, 0.0586), vec3(0.3608, 0.2275, 0.1020));  // 5c3a1a 금 0 · 단 2
		T(74, vec3(0.3063, -0.0307, -0.0290), vec3(0.0784, 0.2039, 0.2471));  // 14343f 청록 0 · 단 2
		T(79, vec3(0.3088, 0.0891, -0.0350), vec3(0.3020, 0.0941, 0.2510));  // 4d1840 분홍 0 · 단 2
		T(80, vec3(0.3710, 0.0019, -0.0333), vec3(0.2275, 0.2471, 0.3216));  // 3a3f52 강철 0 · 단 2
		T(83, vec3(0.3212, 0.0234, -0.0514), vec3(0.2078, 0.1765, 0.3020));  // 352d4d 밤 2 · 단 2
		T(88, vec3(0.3757, 0.0803, 0.0536), vec3(0.4196, 0.1647, 0.1098));  // 6b2a1c 주황 0 · 단 2
		T(100, vec3(0.3085, 0.0800, 0.0095), vec3(0.3137, 0.1059, 0.1608));  // 501b29 벽 2 · 단 2
		T(101, vec3(0.3976, 0.0241, -0.0467), vec3(0.2902, 0.2549, 0.3765));  // 4a4160 회보라 1 · 단 2
		T(102, vec3(0.3563, 0.0405, 0.0406), vec3(0.3333, 0.1961, 0.1333));  // 553222 나무 2b · 단 2
	}
	if (x.x > 0.30 && x.x < 0.60) {    // L 0.4~0.5
